      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Coordinator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('coordinatorToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coordinator@santrionn.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@santrionn.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login as Responder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('responderToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"responder.medical@santrionn.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Dashboard",
      "item": [
        {
          "name": "Get Command Center Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Incidents",
      "item": [
        {
          "name": "List Incidents (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents?status=ACTIVE&severity=CRITICAL&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["incidents"],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "severity",
                  "value": "CRITICAL"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Incident (Auto Priority Score)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('activeIncidentId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Chemical Factory Explosion & Fire\",\n  \"description\": \"Major industrial fire reported at Sector 62 Chemical Processing Plant with toxic fumes.\",\n  \"type\": \"FIRE\",\n  \"severity\": \"CRITICAL\",\n  \"affectedPeople\": 250,\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [77.3620, 28.6280]\n  },\n  \"address\": \"Industrial Area Phase II, Sector 62, Noida\",\n  \"requiredSkills\": [\"FIRE\", \"SEARCH_AND_RESCUE\", \"MEDICAL\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents",
              "host": ["{{baseUrl}}"],
              "path": ["incidents"]
            }
          }
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{activeIncidentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "{{activeIncidentId}}"]
            }
          }
        },
        {
          "name": "Transition Incident Status (State Machine)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\",\n  \"notes\": \"Site inspection confirmed by Sector 62 Fire Chief.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{activeIncidentId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "{{activeIncidentId}}", "status"]
            }
          }
        },
        {
          "name": "Get Incident Timeline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidents/{{activeIncidentId}}/timeline",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "{{activeIncidentId}}", "timeline"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Responders",
      "item": [
        {
          "name": "List Responders (Filter by Skill & Status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/responders?status=AVAILABLE&skills=FIRE",
              "host": ["{{baseUrl}}"],
              "path": ["responders"],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                },
                {
                  "key": "skills",
                  "value": "FIRE"
                }
              ]
            }
          }
        },
        {
          "name": "Search Nearby Responders (2dsphere Geospatial)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/responders/nearby?longitude=77.3620&latitude=28.6280&radiusKm=25&skills=FIRE",
              "host": ["{{baseUrl}}"],
              "path": ["responders", "nearby"],
              "query": [
                {
                  "key": "longitude",
                  "value": "77.3620"
                },
                {
                  "key": "latitude",
                  "value": "28.6280"
                },
                {
                  "key": "radiusKm",
                  "value": "25"
                },
                {
                  "key": "skills",
                  "value": "FIRE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Responder Status / Location",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\",\n  \"location\": {\n    \"type\": \"Point\",\n    \"coordinates\": [77.3650, 28.6300]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/responders/{{activeResponderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["responders", "{{activeResponderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Assignments",
      "item": [
        {
          "name": "Assign Responder to Incident (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('activeAssignmentId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "req-dispatch-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"responderId\": \"{{activeResponderId}}\",\n  \"notes\": \"Deploy immediately to Sector 62 North Perimeter for search and rescue operations.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incidents/{{activeIncidentId}}/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["incidents", "{{activeIncidentId}}", "assignments"]
            }
          }
        },
        {
          "name": "Update Assignment Status (Responder Workflow)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{responderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"notes\": \"En route with crew and breathing apparatus.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assignments/{{activeAssignmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["assignments", "{{activeAssignmentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Resources & Concurrency Safety",
      "item": [
        {
          "name": "List Stockpile Resources",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resources",
              "host": ["{{baseUrl}}"],
              "path": ["resources"]
            }
          }
        },
        {
          "name": "Allocate Resource Atomically ($gte & $inc)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "alloc-key-res-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incidentId\": \"{{activeIncidentId}}\",\n  \"quantity\": 2,\n  \"notes\": \"Trauma medical kits for triage center alpha.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resources/{{activeResourceId}}/allocate",
              "host": ["{{baseUrl}}"],
              "path": ["resources", "{{activeResourceId}}", "allocate"]
            }
          }
        },
        {
          "name": "Release / Return Resource Allocation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Unused trauma supplies returned to central depot.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resources/allocations/{{activeAllocationId}}/release",
              "host": ["{{baseUrl}}"],
              "path": ["resources", "allocations", "{{activeAllocationId}}", "release"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Audit Logs",
      "item": [
        {
          "name": "Query Audit Trail (Role Protected: Admin/Coordinator Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{coordinatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?limit=50&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["audit-logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
