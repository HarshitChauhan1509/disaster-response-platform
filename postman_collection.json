{
  "info": {
    "_postman_id": "7b89d4e1-2c1a-4632-9b2f-91a54721c0e3",
    "name": "Santrionn Technologies - Disaster Response Platform API",
    "description": "Comprehensive API collection for the Disaster Response Coordination Platform.\nIncludes authentication, incidents, responders, assignments, concurrency-safe resource allocation, operational dashboard metrics, and audit logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "coordinatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
