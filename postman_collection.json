      "type": "string"
    },
    {
      "key": "responderToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeIncidentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeResponderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeResourceId",
      "value": "",
